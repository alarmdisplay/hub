{
  "name": "@alarmdisplay/hub",
  "description": "Backend for collecting, processing and forwarding alerts",
  "version": "1.0.0-beta.5",
  "homepage": "https://alarmdisplay.org",
  "private": true,
  "main": "src",
  "author": {
    "name": "Andreas Brain",
    "email": "dev@abrain.de"
  },
  "contributors": [],
  "bugs": {},
  "directories": {
    "lib": "src",
    "test": "test/",
    "config": "config/"
  },
  "engines": {
    "node": ">= 16.0.0",
    "npm": ">= 7.0.0"
  },
  "scripts": {
    "test": "npm run compile && npm run jest",
    "lint": "eslint src/. test/. --config .eslintrc.json --ext .ts",
    "lint:fix": "eslint src/. test/. --config .eslintrc.json --ext .ts --fix",
    "dev": "ts-node-dev --no-notify --rs src/",
    "start": "npm run compile && node lib/",
    "jest": "jest --runInBand --forceExit",
    "jest:watch": "jest --runInBand --forceExit --watch",
    "compile": "shx rm -rf lib/ && tsc"
  },
  "standard": {
    "env": [
      "jest"
    ],
    "ignore": []
  },
  "types": "lib/",
  "dependencies": {
    "@feathersjs/authentication": "4.5.21",
    "@feathersjs/authentication-local": "4.5.21",
    "@feathersjs/configuration": "4.5.21",
    "@feathersjs/errors": "4.5.21",
    "@feathersjs/express": "4.5.21",
    "@feathersjs/feathers": "4.5.21",
    "@feathersjs/socketio": "4.5.21",
    "@feathersjs/transport-commons": "4.5.21",
    "@types/node": "22.20.1",
    "axios": "1.19.0",
    "bcryptjs": "2.4.3",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "feathers-hooks-common": "5.0.6",
    "feathers-sequelize": "6.4.0",
    "feathers-shallow-populate": "2.5.1",
    "gauss-krueger": "1.0.1",
    "joi": "17.13.7",
    "log4js": "6.9.1",
    "mysql2": "3.22.3",
    "sequelize": "6.37.8",
    "serialport": "12.0.0",
    "serve-favicon": "2.5.1",
    "umzug": "3.8.2",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@faker-js/faker": "9.9.0",
    "@types/bcryptjs": "2.4.6",
    "@types/bluebird": "3.5.42",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/ms": "2.1.0",
    "@types/serve-favicon": "2.5.7",
    "@types/umzug": "2.3.9",
    "@types/uuid": "10.0.0",
    "@types/validator": "13.15.10",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "8.57.1",
    "feathers-factory": "4.0.2",
    "jest": "29.7.0",
    "shx": "0.4.0",
    "sqlite3": "5.1.7",
    "ts-jest": "29.4.12",
    "ts-node-dev": "2.0.0",
    "typescript": "5.8.3"
  }
}
